<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Sillas y Sitiales | Pinky's Furniture</title>

<link rel="stylesheet" href="estilos.css">

</head>

<body>


<!-- =================================
     ENCABEZADO
================================= -->

<header class="encabezado-secundario">

    <a
        href="index.html"
        class="volver"
    >
        ← Pinky's Furniture
    </a>


    <h1>Sillas y Sitiales</h1>

    <p>
        Descubre nuestra colección de sillas y sitiales
    </p>


    <!-- BUSCADOR -->

    <div class="buscador-pagina">

        <input
            type="text"
            id="busqueda"
            placeholder="Buscar sillas o sitiales..."
        >

        🔍

    </div>

</header>



<!-- =================================
     PRODUCTOS
================================= -->

<main class="contenedor">

    <div
        id="listaProductos"
        class="productos-grid"
    ></div>

</main>



<!-- =================================
     CARRITO
================================= -->

<button
    class="boton-carrito"
    onclick="abrirCarrito()"
>

    🛒

    <span
        id="contadorCarrito"
        class="contador"
    >
        0
    </span>

</button>



<!-- PANEL DEL CARRITO -->

<aside
    id="carritoPanel"
    class="carrito-panel"
>

    <div class="carrito-header">

        <h2>Mi carrito</h2>

        <button onclick="cerrarCarrito()">
            ×
        </button>

    </div>


    <div
        id="carritoContenido"
        class="carrito-contenido"
    ></div>


    <div class="carrito-footer">

        <div class="total">

            <span>Total</span>

            <strong id="carritoTotal">
                $0
            </strong>

        </div>


        <button
            class="boton-principal"
            onclick="abrirFormulario()"
        >

            Continuar compra

        </button>

    </div>

</aside>



<!-- =================================
     FORMULARIO CLIENTE
================================= -->

<div
    id="modalFormulario"
    class="modal"
>

    <div class="formulario">

        <button
            class="cerrar-modal"
            onclick="cerrarFormulario()"
        >
            ×
        </button>


        <h2>Datos del cliente</h2>


        <label>
            Nombre completo *
        </label>

        <input
            type="text"
            id="nombreCliente"
        >


        <label>
            Teléfono *
        </label>

        <input
            type="tel"
            id="telefonoCliente"
        >


        <label>
            Correo electrónico
        </label>

        <input
            type="email"
            id="correoCliente"
        >


        <label>
            Dirección *
        </label>

        <input
            type="text"
            id="direccionCliente"
        >


        <label>
            Comuna *
        </label>

        <input
            type="text"
            id="comunaCliente"
        >


        <label>
            Observaciones
        </label>

        <textarea
            id="observacionesCliente"
        ></textarea>


        <button
            class="boton-whatsapp-final"
            onclick="enviarPedidoWhatsApp()"
        >

            💬 Enviar pedido por WhatsApp

        </button>

    </div>

</div>



<!-- =================================
     WHATSAPP FLOTANTE
================================= -->

<a
    href="https://wa.me/56921655008"
    target="_blank"
    class="whatsapp-flotante"
>

    💬

</a>



<!-- =================================
     FOOTER
================================= -->

<footer>

    <strong>Pinky's Furniture</strong>

    <p>
        Muebles y soluciones para tu negocio
    </p>

    <p>
        © 2026 Pinky's Furniture
    </p>

</footer>



<!-- =================================
     JAVASCRIPT
================================= -->

<script src="productos.js"></script>

<script src="sillas-productos.js"></script>

<script src="carrito.js"></script>



<script>

/* =====================================
   MOSTRAR SILLAS
===================================== */

const contenedor =
    document.getElementById("listaProductos");


function mostrarSillas(lista = productosSillas) {

    mostrarProductosEnContenedor(
        lista,
        contenedor
    );

}


mostrarSillas();



/* =====================================
   BUSCADOR
===================================== */

document
.getElementById("busqueda")
.addEventListener("input", function() {

    const texto =
        this.value
        .toLowerCase()
        .trim();


    if (!texto) {

        mostrarSillas();

        return;

    }


    const resultados =
        productosSillas.filter(producto =>

            producto.nombre
            .toLowerCase()
            .includes(texto)

            ||

            producto.codigo
            .toLowerCase()
            .includes(texto)

        );


    mostrarSillas(resultados);

});

</script>


</body>

</html>
